package views

import (
	"fmt"
	"observer/internal/query"
)

templ AnalysisPage(
	title,
	queryString,
	editorContent,
	timeFrom,
	timeTo string,
) {
	@Layout(title) {
		@AnalysisPageContent(
			queryString,
			editorContent,
			timeFrom,
			timeTo,
		)
	}
	@AnalysisScript()
}

templ AnalysisPageContent(
	queryString,
	editorContent,
	timeFrom,
	timeTo string,
) {
	<div id="analysis-page-content">
		<link rel="stylesheet" href="/static/log-explorer.css"/>
		<link rel="stylesheet" href="/static/analysis.css"/>
		<header class="page-header">
			<h1>Analysis</h1>
			<p>Analyze historical API traffic.</p>
		</header>
		<form
			id="analysis-query-form"
			class="analysis-query"
			hx-post="/analysis/run"
			hx-target="#analysis-table-body"
			hx-swap="innerHTML"
		>
			<div class="analysis-time-range">
				<div class="analysis-time-field">
					<label for="time-from">From</label>
					<input
						type="datetime-local"
						id="time-from"
						name="time_from"
						value={ timeFrom }
					/>
				</div>
				<div class="analysis-time-field">
					<label for="time-to">To</label>
					<input
						type="datetime-local"
						id="time-to"
						name="time_to"
						value={ timeTo }
					/>
				</div>
			</div>
			<div class="analysis-query-bar">
				<input
					type="text"
					name="query"
					placeholder="Filter logs..."
					value={ queryString }
					autocomplete="off"
				/>
				<textarea
					id="analysis-rules-input"
					name="rules"
					hidden
				>{ editorContent }</textarea>
				<button type="submit">
					Run
				</button>
			</div>
		</form>
		<div class="analysis-layout">
			<nav class="analysis-tabs" aria-label="Analysis views">
				<button
					type="button"
					class="analysis-tab active"
					data-analysis-tab="logs"
				>
					Logs
				</button>
				<button
					type="button"
					class="analysis-tab"
					data-analysis-tab="statistics"
				>
					Statistics
				</button>
				<button
					type="button"
					class="analysis-tab"
					data-analysis-tab="rules"
				>
					Rules
				</button>
			</nav>
			<div
				class="analysis-view active"
				data-analysis-view="logs"
			>
				<div class="log-explorer-layout">
					<div class="log-explorer-main">
						<div class="log-table-wrapper">
							<div
								id="log-loading"
								class="htmx-indicator log-loading-overlay"
							>
								<div class="log-loading">
									<span class="loading-spinner"></span>
									<span>Loading logs...</span>
								</div>
							</div>
							<table class="log-table">
								<thead>
									<tr>
										<th>Timestamp</th>
										<th>Host</th>
										<th>Type</th>
										<th>Method</th>
										<th>Path</th>
										<th>Status</th>
										<th>Findings</th>
									</tr>
								</thead>
								<tbody
									id="analysis-table-body"
								></tbody>
							</table>
						</div>
					</div>
					<div id="log-explorer-details"></div>
				</div>
			</div>
			<div
				class="analysis-view"
				data-analysis-view="statistics"
			>
				<div class="analysis-statistics">
					<p>Statistics will go here.</p>
				</div>
			</div>
			<div
				class="analysis-view"
				data-analysis-view="rules"
			>
				<div class="analysis-rules">
					<header class="analysis-section-header">
						<div>
							<h2>Rules</h2>
							<p>
								Add the rules to include in this analysis.
							</p>
						</div>
					</header>
					<div class="analysis-rules-list">
						<div id="editor-container"></div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ AnalysisResults(
	queryString,
	rules,
	from,
	to string,
	cursor int,
) {
	<tr
		hidden
		hx-post={ fmt.Sprintf(
			"/analysis/logs?query=%s&from=%s&to=%s&cursor=%d",
			queryString,
			from,
			to,
			cursor,
		) }
		hx-trigger="load"
		hx-swap="outerHTML"
		hx-include="this"
	>
		<td colspan="7">
			<textarea
				name="rules"
				hidden
			>{ rules }</textarea>
		</td>
	</tr>
}

templ AnalysisTableRows(
	items []query.LogItem,
	queryString,
	from,
	to,
	rules string,
	cursor query.LogCursor,
) {
	for _, item := range items {
		<tr
			class="log-row"
			hx-get={ fmt.Sprintf(
				"/logs/details?cursor=%d",
				item.JobCursor,
			) }
			hx-trigger="click"
			hx-target="#log-explorer-details"
			hx-swap="innerHTML"
		>
			<td class="log-timestamp">
				{ item.Job.Timestamp }
			</td>
			<td class="log-host">
				{ item.Job.Host }
			</td>
			<td class="log-type">
				{ item.Job.Type }
			</td>
			<td class="log-method">
				{ item.Job.Method }
			</td>
			<td class="log-path">
				{ item.Job.Path }
			</td>
			<td class="log-status">
				if item.Job.Status > 0 {
					{ fmt.Sprintf("%d", item.Job.Status) }
				} else {
					<span>-</span>
				}
			</td>
			<td class="log-findings">
				if len(item.Findings) > 0 {
					{ fmt.Sprintf("%d", len(item.Findings)) }
				} else {
					<span>-</span>
				}
			</td>
		</tr>
	}

	if len(items) > 0 {
		<tr
			class="log-load-more"
			hx-post={ fmt.Sprintf(
				"/analysis/logs?query=%s&from=%s&to=%s&cursor=%d",
				queryString,
				from,
				to,
				cursor,
			) }
			hx-trigger="intersect once"
			hx-swap="outerHTML"
			hx-include="this"
			hx-indicator="#log-loading"
		>
			<td colspan="7" class="log-load-trigger">
				<textarea name="rules" hidden>{ rules }</textarea>
			</td>
		</tr>
	} else {
		<tr class="log-end-row">
			<td colspan="7">
				End of logs
			</td>
		</tr>
	}
}

templ AnalysisScript() {
	<script src="/static/monaco-editor-0.56.0/package/min/vs/loader.js"></script>
	<script>
		(() => {
			/*
			 * Tabs
			 */
			const tabs = document.querySelectorAll("[data-analysis-tab]");

			const views = document.querySelectorAll("[data-analysis-view]");

			tabs.forEach((tab) => {
				tab.addEventListener("click", () => {
					const selectedView = tab.dataset.analysisTab;

					tabs.forEach((item) => {
						item.classList.toggle("active", item === tab);
					});

					views.forEach((view) => {
						view.classList.toggle(
							"active",
							view.dataset.analysisView === selectedView,
						);
					});

					if (selectedView === "rules" && window.analysisRuleEditor) {
						window.analysisRuleEditor.layout();
					}
				});
			});

			/*
			 * Monaco
			 */
			require.config({
				paths: {
					vs: "/static/monaco-editor-0.56.0/package/min/vs",
				},
			});

			require(["vs/editor/editor.main"], function () {
				const editorContainer = document.getElementById("editor-container");

				const rulesInput = document.getElementById("analysis-rules-input");

				const editor = monaco.editor.create(editorContainer, {
					value:
						rulesInput.value ||
						`rules:
  `,
					language: "yaml",
					theme: "vs-dark",
					automaticLayout: true,

					minimap: {
						enabled: false,
					},

					scrollBeyondLastLine: false,
					fontSize: 14,
					tabSize: 2,
				});

				window.analysisRuleEditor = editor;

				/*
				 * Keep hidden form field in sync.
				 */
				editor.onDidChangeModelContent(() => {
					rulesInput.value = editor.getValue();
				});
			});

			/*
			 * Make absolutely sure the latest editor
			 * contents are submitted.
			 */
			const form = document.getElementById("analysis-query-form");

			form.addEventListener("submit", () => {
				const rulesInput = document.getElementById("analysis-rules-input");

				if (window.analysisRuleEditor) {
					rulesInput.value = window.analysisRuleEditor.getValue();
				}
			});
		})();
	</script>
}
