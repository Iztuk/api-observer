package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			<input
				id="sidebar-toggle"
				class="sidebar-toggle"
				type="checkbox"
			/>
			<div class="app-layout">
				@Sidebar()
				<div class="page">
					<header class="mobile-header">
						<label
							for="sidebar-toggle"
							class="menu-button"
							aria-label="Open navigation"
						>
							<span></span>
							<span></span>
							<span></span>
						</label>
						<a href="/app" class="mobile-title">
							API Observer
						</a>
					</header>
					<main id="main-content">
						{ children... }
					</main>
				</div>
			</div>
			<label
				for="sidebar-toggle"
				class="sidebar-overlay"
				aria-label="Close navigation"
			></label>
		</body>
	</html>
}
